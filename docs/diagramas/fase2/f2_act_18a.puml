@startuml
!pragma useVerticalIf on
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Liberation Sans
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam dpi 170
skinparam ActivityDiamondFontSize 13
|Funcionario|
start
:1. Inicia el registro de una entrega (MK-06);
repeat
  :2. Ingresa tipo y número de
  documento del beneficiario;
  |Sistema|
repeat while (¿Falta el documento?\n[RN-06]) is (sí: FA-01, lo solicita) not (no)
:3. Verifica la identidad (CU-17);
if (¿La persona está censada?\n[RN-22]) then (no)
  :FA-02. «La persona no figura
  en el censo.»;
  stop
elseif (¿Integrante y hogar activos?\n[RN-34]) then (no)
  :FA-03. Indica que el
  registro está inactivo;
  stop
else (sí)
endif
(A)
detach
@enduml