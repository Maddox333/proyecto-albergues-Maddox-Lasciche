@startuml
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Liberation Sans
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam dpi 170
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 6
skinparam BoxPadding 4
hide footbox
autonumber
actor "Funcionario" as F
actor "Beneficiario" as B
boundary "MK-06\nRegistrar entrega" as V
control "EntregaControlador" as C
entity ":Integrante" as Integrante
entity ":TipoAyuda" as TipoAyuda
entity ":Entrega" as Entrega
database "BD" as DB
F -> V : ingresa el documento del beneficiario;\nclic «Verificar»
alt documento vacío [RN-06]
  V --> F : solicita el documento (FA-01)
else documento ingresado
  V -> C : «evento» Verificar (CU-17)
  C -> Integrante : buscarPorDocumento(tipo, numero)
  Integrante -> DB : SELECT … FROM INTEGRANTE\nJOIN HOGAR
  Integrante --> C : integrante y hogar, o nulo
  alt no figura en el censo [RN-22]
    C --> V : «La persona no figura en el censo.» (FA-02)
  else integrante u hogar inactivo [RN-34]
    C --> V : indica que el registro está inactivo (FA-03)
  else verificado
    C --> V : beneficiario verificado (CA-18.1)
    F -> V : selecciona el tipo e ingresa la cantidad
    note over V : tipo seleccionado y cantidad > 0\n[RN-23, RN-17] (FA-05, FA-06)
    V -> C : «evento» Validar cantidad (CU-18)
    C -> TipoAyuda : hayExistencias(cantidad)
    TipoAyuda -> TipoAyuda : existencias()
    TipoAyuda -> DB : SUM(DONACION) − SUM(ENTREGA)
    TipoAyuda --> C : boolean
    alt existencias insuficientes o tipo agotado [RN-21]
      C --> V : unidades disponibles o agotado (FA-07, FA-08)
    else existencias suficientes
      B -> V : firma en el dispositivo
      F -> V : clic «Capturar firma»
      V -> C : «evento» Capturar firma (CU-19)
      C -> Entrega : capturarFirma(firma)
      F -> V : clic «Registrar entrega»
      V -> C : «evento» Registrar entrega (CU-18)
      alt sin firma [RN-24]
        C --> V : solicita la firma (FA-09)
      else con firma
        C -> Entrega : registrar(e)
        Entrega -> DB : INSERT INTO ENTREGA (beneficiario,\ntipo, cantidad, fecha y hora, usuario, firma)
        C --> V : entrega registrada; existencias\n− cantidad [RN-20, RN-23] (CA-19.1)
      end
    end
  end
end
@enduml